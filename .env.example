# Local dev default matches docker-compose.yml — copy this file to .env to use it.
DATABASE_URL="postgresql://mp365:mp365_dev_local@localhost:5433/mp365?schema=public"

# The site's public origin. Drives canonical URLs, every schema.org @id, and
# metadataBase — so it MUST match the deployed domain exactly (no trailing slash).
# Defaults to https://mp-365.com when unset.
# NEXT_PUBLIC_SITE_URL="https://mp-365.com"

# Optional. Where contact-form submissions are forwarded (Teams/Slack incoming
# webhook, or a CRM endpoint). Submissions are always persisted to the
# ContactSubmission table first, so leaving this unset loses nothing — it only
# means no real-time notification. View submissions with `npm run db:studio`.
# CONTACT_WEBHOOK_URL=""

# --- Analytics (optional; nothing loads while these are unset) ---
# GA4 measurement ID. Mark `generate_lead` as a key event in GA4 admin.
# NEXT_PUBLIC_GA_ID="G-XXXXXXXXXX"
# Microsoft Clarity project ID (free heatmaps and session recordings).
# NEXT_PUBLIC_CLARITY_ID=""

# --- Search console ownership (optional) ---
# The content value of Google's HTML-tag verification.
# GOOGLE_SITE_VERIFICATION=""
# The content value of Bing Webmaster Tools' msvalidate.01 meta tag.
# BING_SITE_VERIFICATION=""

# --- Booking (optional) ---
# Public Microsoft Bookings (or Calendly) page. When set, industry pages and
# the readiness check offer "Book a 20-minute call" beside the form.
# NEXT_PUBLIC_BOOKING_URL=""
